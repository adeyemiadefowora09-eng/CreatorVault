# Database
DATABASE_URL=postgresql://user:password@localhost:5432/creatorvault

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Payaza Payment & Escrow Engine
PAYAZA_PUBLIC_KEY=your-payaza-public-key-or-api-key
PAYAZA_SECRET_KEY=your-payaza-secret-key
PAYAZA_BASE_URL=https://api.payaza.africa/live/
PAYAZA_TENANT=test # test or live
PAYAZA_TRANSACTION_PIN=0000 # 4-digit PIN configured in Payaza Dashboard
PAYAZA_ACCOUNT_REFERENCE=your-merchant-account-ref
PAYMENTS_MODE=sandbox # live, sandbox, or test

# OpenAI
OPENAI_API_KEY=sk-xxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS
>>>>>>> 9c15709e71866d0d287652bd5fa6ab5f84e07faf
CORS_ORIGIN=http://localhost:3000

# ---------- payments ----------
# disabled (default, fails closed) | sandbox (Payaza TEST tenant) | live (real money)
PAYMENTS_MODE=disabled
# Only for live, together with NODE_ENV=production:
PAYMENTS_LIVE_CONFIRM=
# Payaza dashboard -> Settings -> Developers -> API Keys.  Use the key pair that matches the mode (test keys for sandbox).
PAYAZA_API_KEY=            # PUBLIC key (raw; the code base64-encodes it). Sent as "Authorization: Payaza <base64>"
PAYAZA_SECRET_KEY=         # SECRET key. Used ONLY to verify webhook signatures.
PAYAZA_BASE_URL=https://api.payaza.africa/live   # the /live segment is fixed; test vs live is the X-TenantID header
PAYAZA_TRANSACTION_PIN=    # 6-digit PIN set in Payaza dashboard (Settings -> Profile -> Security)
PAYAZA_ACCOUNT_REFERENCE=  # optional; auto-fetched if blank
PAYAZA_VA_BANK_CODE=140
PAYAZA_VA_EXPIRY_MINUTES=30
PAYAZA_CUSTOMER_PHONE=07000000000
PLATFORM_FEE_BPS=0
PAYOUT_MIN_AMOUNT=1000
PAYOUT_MAX_AMOUNT=5000000
PAYOUT_COOLDOWN_HOURS=24
REQUIRE_FUNDED_ESCROW=true
ENABLE_RECONCILER=true
RECONCILE_INTERVAL_SECONDS=60

# ---------- other services ----------
OPENAI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
FROM_EMAIL=noreply@creatorvault.com
