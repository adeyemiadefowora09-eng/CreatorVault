# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/creatorvault

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Payaza
PAYAZA_API_KEY=your-payaza-api-key
PAYAZA_SECRET_KEY=your-payaza-secret-key
PAYAZA_BASE_URL=https://router-live.payaza.africa

# OpenAI
OPENAI_API_KEY=sk-xxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS
CORS_ORIGIN=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=notifications@creatorvault.com

# API
API_VERSION=v1
